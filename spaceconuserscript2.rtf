\f0\fs24 \cf0 // ==UserScript==\
// @name SpaceCon Userscript2\
// @version 1.5\
// @description Autoscroll container optimized for the Safari Userscripts app\
// @match *://*.leapevent.tech/*\
// @run-at document-end\
// @grant none\
// @inject-into page\
// ==/UserScript==\
\
(function() \{\
    'use strict';\
\
    const REFRESH_INTERVAL = 900000; \
    const SCROLL_SPEED = 1;          \
    const STEP_INTERVAL = 20;        \
\
    let scriptState = \{\
        refreshCount: 0,\
        lastRefreshTime: Date.now(),\
        customStatus: "active"\
    \};\
\
    const savedState = localStorage.getItem('spacecon_script_state');\
    if (savedState) \{\
        try \{\
            scriptState = JSON.parse(savedState);\
            console.log("\uc0\u55357 \u56580  Loaded saved state", scriptState);\
        \} catch (e) \{\
            console.error("\uc0\u10060  Failed to parse state", e);\
        \}\
    \}\
\
    scriptState.refreshCount++; \
\
    if ('scrollRestoration' in history) \{\
        history.scrollRestoration = 'manual';\
    \}\
    window.scrollTo(0, 0);\
\
    function resetAndRefresh() \{\
        clearInterval(scrollTimer);\
        clearTimeout(refreshTimeout);\
        \
        localStorage.setItem('spacecon_script_state', JSON.stringify(scriptState));\
\
        window.scrollTo(0, 0); \
        location.reload();\
    \}\
\
    const scrollTimer = setInterval(() => \{\
        window.scrollBy(0, SCROLL_SPEED);\
\
        const totalHeight = document.documentElement.scrollHeight;\
        const scrolledDistance = window.innerHeight + window.scrollY;\
\
        if (scrolledDistance >= totalHeight - 2) \{\
            console.log("\uc0\u11015 \u65039  Reached bottom. Refreshing...");\
            resetAndRefresh();\
        \}\
    \}, STEP_INTERVAL);\
\
    const refreshTimeout = setTimeout(() => \{\
        console.log("\uc0\u9201 \u65039  Timeout reached. Refreshing...");\
        resetAndRefresh();\
    \}, REFRESH_INTERVAL);\
\})();\
}